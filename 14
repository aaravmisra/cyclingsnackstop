import { useEffect, useRef } from 'react'
import L from 'leaflet'
import 'leaflet/dist/leaflet.css'

export default function Map({ stops, height = '60vh' }) {
  const container = useRef(null)

  useEffect(() => {
    if (!container.current) return
    const map = L.map(container.current).setView([52.09, 5.12], 13)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap',
    }).addTo(map)

    stops.forEach(s => {
      const popup = `<b>${s.name}</b><br/>${s.vibe}<br/><a href="/stops/${s.slug}">Details →</a>`
      L.marker(s.coords).addTo(map).bindPopup(popup)
    })

    return () => map.remove()
  }, [stops])

  return <div ref={container} className="w-full rounded" style={{ height }} />
}
